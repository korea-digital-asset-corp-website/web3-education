# ============================================================
# Account Abstraction 실습 환경 설정
# ============================================================
# 이 파일을 .env로 복사한 후 값을 채워주세요.
# cp .env.example .env
# ============================================================

# RPC URL
RPC_URL=http://localhost:8545

# 개인키
# ⚠️ 실제 자산이 있는 개인키를 사용하지 마세요!
OWNER_PRIVATE_KEY=
DELEGATE_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=

# 배포된 컨트랙트 주소 (forge script 배포 후 업데이트)
EIP7702_ACCOUNT_IMPL=
EIP7702_FACTORY=
VERIFYING_PAYMASTER=

# Safe 주소 (모든 EVM 체인에서 동일)
SAFE_SINGLETON=0xd9Db270c1B5E3Bd161E8c8503c55cEABeE709552
SAFE_PROXY_FACTORY=0xa6B71E26C5e0845f74c812102Ca7114b6a896AB2
SAFE_FALLBACK_HANDLER=0xf48f2B2d2a534e402487b3ee7C18c33Aec0Fe5e4

# Safe 배포 후 설정 (01-deploy-safe.ts 실행 후 업데이트)
SAFE_ADDRESS=
MODULE_ADDRESS=
